{
  "name": "scsp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "netlify dev",
    "build": "npm -w apps/web run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx db/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@netlify/functions": "^2.8.0",
    "hono": "^4.5.0",
    "jose": "^5.6.0",
    "postgres": "^3.4.4"
  },
  "type": "module"
}