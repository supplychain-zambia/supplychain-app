# Pooled connection string (used by the API at runtime)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Direct (non-pooled) connection string (used for migrations and backups)
DATABASE_URL_DIRECT=postgres://user:pass@host/db?sslmode=require
# At least 32 random characters. Never commit the real value.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=scsp
